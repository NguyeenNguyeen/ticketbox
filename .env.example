# .env file
# LƯU Ý: Dự án sử dụng OS Environment Variables, KHÔNG dùng plugin tự động parse.
# Xem README.md để biết lệnh nạp biến môi trường khi chạy ứng dụng.

# PostgreSQL Config
POSTGRES_USER=ticketbox
POSTGRES_PASSWORD=ticketbox
POSTGRES_DB=ticketbox

# Cloud APIs (Thay bằng key thật của bạn để test)
GEMINI_API_KEY=
RESEND_API_KEY=

# ⚠️ QUAN TRỌNG CHO VIỆC GỬI EMAIL
# Các tuỳ chọn EMAIL_PROVIDER: mock (giả lập), resend (cần tên miền riêng), smtp (dùng Gmail)
EMAIL_PROVIDER=mock
EMAIL_FROM=onboarding@resend.dev

# (Chỉ cần thiết nếu EMAIL_PROVIDER=smtp) Cấu hình Gmail App Password
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password