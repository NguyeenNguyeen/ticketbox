# .env file
# LƯU Ý: Dự án sử dụng OS Environment Variables, KHÔNG dùng plugin tự động parse.
# Xem README.md để biết lệnh nạp biến môi trường khi chạy ứng dụng.

# PostgreSQL Config
POSTGRES_USER=ticketbox
POSTGRES_PASSWORD=ticketbox
POSTGRES_DB=ticketbox

# Cloud APIs (Thay bằng key thật của bạn để test)
GEMINI_API_KEY=AIzaSyYourGeminiKeyHere...
RESEND_API_KEY=re_YourResendKeyHere...

# ⚠️ QUAN TRỌNG CHO VIỆC TEST EMAIL LOCALLY (RESEND SANDBOX)
# Resend mặc định giới hạn gửi từ onboarding@resend.dev đến email đăng ký tài khoản Resend của bạn.
# KHÔNG sử dụng tài khoản customer1 có sẵn vì customer1@gmail.com sẽ bị block.
# Để test email, hãy chạy app và tự đăng ký 1 tài khoản mới bằng email thật của bạn.
EMAIL_FROM=onboarding@resend.dev