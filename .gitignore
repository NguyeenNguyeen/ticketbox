# ========================================
# TicketBox Monorepo .gitignore
# ========================================

# ── Environment & Secrets ──
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.p12
*.jks
*.db

# ── Dependency Directories ──
node_modules/
jspm_packages/
web_modules/
target/
.mvn/wrapper/
.gradle/
.turbo/

# ── Build & Cache Outputs ──
.next/
out/
build/
dist/
bin/
*.class
*.jar
*.war
*.ear
*.tsbuildinfo
next-env.d.ts

# ── IDEs, Editors & Tools ──
.idea/
*.iml
*.ipr
*.iws
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.classpath
.project
.settings/
.factorypath
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.eslintcache

# ── Logs & Runtime ──
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log
logs/
temp/
tmp/

# ── OS Files ──
.DS_Store
Thumbs.db
desktop.ini

# ── Local Agent Cache (Do not ignore conversation docs) ──
.agents/knowledge/member4_scope.md
